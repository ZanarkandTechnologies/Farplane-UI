      ".agents/skills/README.md",
      "docs/bootstrap-brief.md",
      "docs/prd.md",
      "docs/features/README.md",
      "docs/systems/README.md",
      "docs/HISTORY.md",
      "docs/MEMORY.md",
      "docs/TASTE.md",
      "docs/TROUBLES.md",
      "docs/LESSONS.md",
