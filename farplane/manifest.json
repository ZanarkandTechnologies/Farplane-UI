{
  "schema": "farplane_project",
  "spec_version": "1.6.4",
  "template_uses": {
    "farplane-framework": "1.6.4"
  },
  "project": {
    "name": "Farplane UI",
    "description": "Local founder-control office for steering AI work, inspecting runtime-backed teams, and moving ideas through ticket-backed execution and proof.",
    "archetype": "founder_control_ai_office"
  },
  "standard": {
    "tracked": [
      "AGENTS.md",
      ".gitignore",
      "PROJECT_RULES.md",
      "ARCHITECTURE.md",
      "farplane/README.md",
      "farplane/manifest.json",
      "farplane/harness.md",
      "farplane/goals.md",
      "farplane/products.md",
      "farplane/automations.toml",
      "farplane/bindings.md",
      "farplane/hooks.json",
      ".agents/skills/README.md",
      "docs/bootstrap-brief.md",
      "docs/prd.md",
      "docs/features/README.md",
      "docs/systems/README.md",
      "docs/HISTORY.md",
      "docs/MEMORY.md",
      "docs/TASTE.md",
      "docs/TROUBLES.md",
      "docs/LESSONS.md",
      "qa/README.md",
      "qa/AGENTS.md",
      "qa/cookbook/README.md",
      "qa/cookbook/TEMPLATE.md",
      "tickets/README.md",
      "tickets/templates/ticket.md",
      "tickets/archive/"
    ],
    "ignored": [
      ".farplane/README.md",
      ".farplane/state/run-ledger.json",
      ".farplane/reports/",
      ".farplane/evals/runs/",
      ".farplane/logs/"
    ]
  },
  "optional": {
    "tracked": [
      "farplane/pm.json",
      ".githooks/README.md",
      ".githooks/pre-commit",
      ".githooks/pre-push",
      "scripts/pre_commit_check.sh",
      "scripts/pre_push_check.sh",
      "docs/code_review.md",
      "docs/review-agent.md",
      "scripts/collect_review_context.sh",
      "scripts/codex_review_agent.ts",
      "scripts/run_pre_push_review.sh"
    ],
    "ignored": [
      ".farplane/reviews/"
    ]
  },
  "farplane_graph": {
    "framework_core": {
      "include": [
        "AGENTS.md",
        "PROJECT_RULES.md",
        "ARCHITECTURE.md",
        "docs/bootstrap-brief.md",
        "docs/prd.md",
        "docs/features/README.md",
        "docs/systems/README.md",
        "docs/features/FEAT-0002-harness-product-model.md",
        "farplane/README.md",
        "farplane/harness.md",
        "farplane/goals.md",
        "farplane/products.md",
        "farplane/automations.toml",
        "farplane/bindings.md",
        "farplane/hooks.json",
        "tickets/README.md"
      ],
      "exclude": [
        "tickets/archive/**",
        ".farplane/reports/**",
        ".farplane/logs/**",
        "tmp/**"
      ]
    }
  }
}
