{
  "name": "@farplane/youtube-shortcut",
  "displayName": "Farplane YouTube Shortcut",
  "version": "0.1.0",
  "description": "Cache-first YouTube summaries through local Codex tasks",
  "author": "kenjipcx",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "dev:agent": "tsx scripts/local-agent.ts",
    "build": "plasmo build && node scripts/verify-extension-build.mjs",
    "package": "plasmo package",
    "test": "node --import tsx --test background.test.ts scripts/local-agent.test.ts scripts/video-intelligence-cloud.test.ts scripts/ingest-channel-manifest.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "convex": "^1.32.0",
    "lucide-react": "^0.473.0",
    "plasmo": "0.90.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.306",
    "@types/node": "24.10.4",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "tsx": "latest",
    "typescript": "5.9.3"
  },
  "manifest": {
    "key": "",
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://*.youtube.com/*",
      "http://127.0.0.1/*"
    ]
  }
}
