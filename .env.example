# Farplane environment variable inventory, ordered by owner/surface.
# Copy only non-secret values into `.env.local`. Blank secret names document
# the runtime contract; populate them in Doppler, never in local env/config files.
# Setup: `doppler setup`, then `doppler secrets set VARIABLE_NAME`.
# Run: `farplane run -- <command>` from the project checkout.

## 1. Convex / telemetry backend
# Public Convex site URL used by hooks and CLI ingestion.
CONVEX_SITE_URL=

# Optional Farplane-specific override for hook/CLI telemetry ingestion.
FARPLANE_CONVEX_SITE_URL=

# Optional token required by `/telemetry/hooks` when Convex is configured to enforce one.
FARPLANE_TELEMETRY_TOKEN=

# Optional bearer token protecting the local Farplane state bridge.
FARPLANE_STATE_BRIDGE_TOKEN=

## 2. Codex hook telemetry
# Optional comma/newline-separated project-relative globs for tracked file summaries.
# Prefer the Raw Telemetry -> Hooks UI and `.farplane/hooks/config.json` for normal use.
FARPLANE_FILE_CHANGE_PATTERNS=

# Optional model override for local `codex exec` file-change summaries.
# Default in code: gpt-5.4-mini
FARPLANE_FILE_CHANGE_SUMMARY_MODEL=

# Optional hook debug logs.
FARPLANE_FILE_CHANGE_HOOK_DEBUG=
FARPLANE_SKILL_HOOK_DEBUG=

## 3. UI-safe Vite values
# Non-secret Vite values may live in `ui/.env.local`. Inject credential values.
VITE_CONVEX_URL=
VITE_FARPLANE_RUNTIME_ADAPTER=codex
VITE_CODEX_APP_SERVER_URL=
VITE_GATEWAY_URL=
VITE_GATEWAY_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=

## 4. Optional integrations
FARPLANE_MESHY_API_KEY=
MESHY_API_KEY=
NOTION_API_KEY=
TELEGRAM_BOT_TOKEN=
SLASH_API_KEY=

## 5. Realtime employee calls
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

## 6. Optional model and media providers
OPENAI_API_KEY=
CODEX_API_KEY=
ELEVENLABS_API_KEY=

## 7. Local automation/review tooling
FARPLANE_STATE_BASE=
CODEX_REVIEW_MODEL=
CODEX_REVIEW_TIMEOUT_MS=
STRICT_AGENT_REVIEW=
FARPLANE_SKIP_AGENT_REVIEW=
